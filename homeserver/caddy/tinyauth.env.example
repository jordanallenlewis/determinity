# tinyauth.env.example - settings for the sign-in service. Placeholders only; contains no secret.
# The one user (name, password hash, TOTP seed) lives in a separate root-only users file that
# `hs-trinity-gate init` creates and the compose file mounts read-only. Copy this file to
# /etc/homeserver/trinity-gate/tinyauth.env and edit.

# Public address of the sign-in page (must match the Caddy site name).
TINYAUTH_APPURL=https://auth.example.com
# Listen on loopback only; Caddy is the only client.
TINYAUTH_SERVER_ADDRESS=127.0.0.1
TINYAUTH_SERVER_PORT=8783
# Inside the container (see the compose file).
TINYAUTH_AUTH_USERSFILE=/run/gate/users
# The session cookie is scoped to the parent domain (example.com) so it reaches trinity.example.com.
# This also sends it to every other *.example.com host you run; use a dedicated parent domain if that matters.
TINYAUTH_AUTH_SUBDOMAINSENABLED=true
TINYAUTH_AUTH_SECURECOOKIE=true
# Seconds a sign-in lasts (24 h).
TINYAUTH_AUTH_SESSIONEXPIRY=86400
# Lock out after 5 failed attempts for 900 seconds.
TINYAUTH_AUTH_LOGINMAXRETRIES=5
TINYAUTH_AUTH_LOGINTIMEOUT=900
# Caddy reaches the service from loopback; trust its forwarded headers only from there.
TINYAUTH_AUTH_TRUSTEDPROXIES=127.0.0.1
TINYAUTH_ANALYTICS_ENABLED=false
TINYAUTH_DATABASE_PATH=/data/tinyauth.db
