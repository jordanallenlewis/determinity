{
  "repos": ["OWNER/REPO"],
  "base": "main",
  "merge_label": "automerge",
  "hold_label": "hold",
  "prefixes": ["agent-a/", "agent-b/", "docs/"],
  "merge_method": "squash",
  "required_checks": ["test", "lint"],
  "check_app_ids": {},
  "high_paths": [".github/workflows/**", "**/migrations/**", "CODEOWNERS", "**/auth/**"],
  "low_paths": ["docs/**", "*.md"],
  "medium_max_lines": 400,
  "review_lead": "review/lead",
  "review_principal": "review/principal",
  "signer_login": "review-signer-account",
  "broker_login": "OWNER",
  "owner_emails": ["OWNER@users.noreply.github.com"],
  "extra_message_patterns": ["^signed-off-by-bot:"],
  "interval": 60
}
