#!/usr/bin/env python3
"""merge-gate: a deterministic, host-side merge gate. Python 3.11+, stdlib only.

For every configured repo, merge an open PR only when ALL of these hold on the PR's head SHA:
  1. not a draft, carries the merge label, has no hold label, base is the repo default (or configured base),
     head branch starts with an allowed prefix;
  2. author identity and commit message policy: every commit's author and committer email is in the owner
     allowlist, and no commit message, PR title or PR body matches a policy pattern (otherwise: post status `merge-gate` = failure
     once, merge nothing);
  3. required checks are green (empty list = every reported check is green and at least one exists). A check is
     green only through a CHECK RUN: a commit status can make a check worse (failure, pending), never green, because
     any token with write access can post a status;
  4. review statuses for the risk tier are success on that SHA: low/medium need the lead status, high needs the lead
     and the principal status; medium also has a changed-lines cap (over the cap = a human merges). A review/*
     status counts only when it was posted by the configured signer_login account; anyone else's is ignored.
     Without signer_login or broker_login (the account agents' writes are made as; "-" = no broker on this host),
     or when signer_login is the gate's own account or broker_login, the gate refuses every merge and says so in a
     failure status.
Tier comes from path globs: high_paths -> high; all files in low_paths -> low; anything else -> medium.
Any error, missing data or unknown state means "do not merge". Nothing here calls a model.

State (/var/lib/homeserver/merge-gate/state.json) remembers merged and refused SHAs so nothing is retried in a loop.
Kill switch: the file /etc/homeserver/merge-gate.disable makes every run a no-op.
"""
import argparse, fcntl, hashlib, json, os, re, sys, time, urllib.error, urllib.request

KILL = os.environ.get("MERGE_GATE_DISABLE_FILE", "/etc/homeserver/merge-gate.disable")
CONFIG = os.environ.get("MERGE_GATE_CONFIG", "/etc/homeserver/merge-gate/config.json")
STATE = os.environ.get("MERGE_GATE_STATE", "/var/lib/homeserver/merge-gate/state.json")
TOKEN_FILE = os.environ.get("MERGE_GATE_TOKEN_FILE", "/etc/homeserver/merge-gate/github-token")
API = os.environ.get("MERGE_GATE_API", "https://api.github.com").rstrip("/")
CONTEXT = "merge-gate"
MAX_ATTEMPTS = 3

DEFAULTS = {
    "merge_label": "automerge", "hold_label": "hold", "prefixes": [], "base": None,
    "merge_method": "squash", "required_checks": [], "ok_conclusions": ["success", "neutral", "skipped"],
    "high_paths": [".github/workflows/**", "**/migrations/**", "CODEOWNERS", "**/auth/**"],
    "low_paths": ["docs/**", "*.md"], "medium_max_lines": 400,
    "review_lead": "review/lead", "review_principal": "review/principal",
    "owner_emails": [], "extra_message_patterns": [], "interval": 60,
    "signer_login": "",      # GitHub login the review signer posts as; review/* statuses from anyone else are ignored
    "broker_login": "",      # GitHub login of the token the GitHub broker forwards agents' calls with; required ("-" = no broker on this host)
    "check_app_ids": {},     # optional {check name: GitHub App id}; only check runs from that app count for that name
}
NO_SIGNER = "signer_login is not set in the merge-gate config"
NO_BROKER = "broker_login is not set in the merge-gate config (the broker's GitHub login, or - when no broker runs here)"
SHARED_SIGNER = "signer_login is an account agents or the gate also write as; it must be a dedicated account"
# Commit message policy: no built-in patterns. The regexes live in the config key extra_message_patterns
# (compiled case-insensitive and multi-line). Empty by default.


def log(msg):
    print(time.strftime("%Y-%m-%dT%H:%M:%S%z"), msg, flush=True)


# ---------- pure decision logic (unit tested offline) ----------
def glob_re(pat):
    """Glob to regex: ** crosses directories, * and ? do not; a pattern without '/' matches that name at any depth."""
    out, i = "", 0
    while i < len(pat):
        if pat.startswith("**/", i): out += "(?:.*/)?"; i += 3
        elif pat.startswith("**", i): out += ".*"; i += 2
        elif pat[i] == "*": out += "[^/]*"; i += 1
        elif pat[i] == "?": out += "[^/]"; i += 1
        else: out += re.escape(pat[i]); i += 1
    return re.compile(("(?:.*/)?" if "/" not in pat else "") + out)


def match_any(path, globs):
    return any(glob_re(g).fullmatch(path) for g in globs)


def tier_for(cfg, paths):
    if any(match_any(p, cfg["high_paths"]) for p in paths): return "high"
    if paths and all(match_any(p, cfg["low_paths"]) for p in paths): return "low"
    return "medium"


def review_reason(cfg, tier, lines, states):
    """None when the review requirements for this tier are met, else why not."""
    need = [cfg["review_lead"]] + ([cfg["review_principal"]] if tier == "high" else [])
    missing = [c for c in need if states.get(c) != "success"]
    if missing: return "waiting for review status: " + ", ".join(missing)
    if tier == "medium" and lines > cfg["medium_max_lines"]:
        return f"medium change too large for the gate ({lines} > {cfg['medium_max_lines']} lines): human merge"
    return None


def checks_reason(cfg, states):
    """states: name -> 'success' | 'pending' | 'failure' | <raw conclusion>. Review statuses and our own are ignored."""
    ours = {CONTEXT, cfg["review_lead"], cfg["review_principal"]}
    if cfg["required_checks"]:
        bad = [c for c in cfg["required_checks"] if states.get(c) != "success"]
        return ("required checks not green: " + ", ".join(bad)) if bad else None
    seen = {k: v for k, v in states.items() if k not in ours}
    if not seen: return "no checks reported yet"
    bad = [k for k, v in seen.items() if v not in cfg["ok_conclusions"]]
    return ("checks not green: " + ", ".join(sorted(bad))) if bad else None


def gate_reason(cfg, pr):
    """Cheap eligibility rules from the PR object alone."""
    labels = {str(l.get("name", "")).strip().casefold() for l in pr.get("labels", [])}  # as the broker compares them
    if pr.get("draft"): return "draft"
    if cfg["merge_label"].strip().casefold() not in labels: return f"no {cfg['merge_label']} label"
    if cfg["hold_label"].strip().casefold() in labels: return f"{cfg['hold_label']} label"
    base = cfg.get("base")
    if base and pr["base"]["ref"] != base: return f"base is not {base}"
    ref = pr["head"]["ref"]
    if not any(ref.startswith(p) for p in cfg["prefixes"]): return "branch prefix not allowed"
    return None


def message_policy_problems(cfg, pr, commits):
    """Return (bad_commit_count, pr_text_hit). Any non-zero/True result blocks the merge."""
    pats = [re.compile(p, re.I | re.M) for p in cfg["extra_message_patterns"]]
    allowed = {e.lower() for e in cfg["owner_emails"]}
    bad = 0
    for c in commits:
        cm = c["commit"]
        emails = {(cm.get("author") or {}).get("email", ""), (cm.get("committer") or {}).get("email", "")}
        if any(e.lower() not in allowed for e in emails) or any(p.search(cm.get("message") or "") for p in pats):
            bad += 1
    text = (pr.get("title") or "") + "\n" + (pr.get("body") or "")
    return bad, any(p.search(text) for p in pats)


def message_policy_description(bad, text_hit):
    parts = ([f"{bad} commit{'s' if bad != 1 else ''}"] if bad else []) + (["PR text"] if text_hit else [])
    return "commit message policy failed: " + ", ".join(parts)


# ---------- GitHub access ----------
class Gh:
    def __init__(self, token): self.token = token

    def call(self, method, path, body=None):
        req = urllib.request.Request(API + path, method=method, data=json.dumps(body).encode() if body is not None else None)
        req.add_header("Accept", "application/vnd.github+json")
        req.add_header("User-Agent", "merge-gate")
        if self.token: req.add_header("Authorization", "Bearer " + self.token)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.status, json.loads(r.read() or b"null")
        except urllib.error.HTTPError as e:
            try: return e.code, json.loads(e.read() or b"null")
            except ValueError: return e.code, None

    def post(self, path, body): return self.call("POST", path, body)

    def put(self, path, body): return self.call("PUT", path, body)

    def get(self, path):
        code, data = self.call("GET", path)
        if code != 200: raise RuntimeError(f"GET {path} -> {code}")
        return data

    def pages(self, path, key=None):
        out, n, sep = [], 1, "&" if "?" in path else "?"
        while n <= 30:
            data = self.get(f"{path}{sep}per_page=100&page={n}")
            items = data[key] if key else data
            out += items
            if len(items) < 100: break
            n += 1
        return out


def state_rank(state):
    """Badness of a state: 0 success, 1 neutral/skipped, 2 not finished or missing, 3 anything else (failed, unknown)."""
    if state == "success": return 0
    if state in ("neutral", "skipped"): return 1
    if state in ("pending", "queued", "in_progress", "waiting", "requested", "missing"): return 2
    return 3


def worse(a, b):
    """The worse of two states (ties keep a). Neutral/skipped rank above success, so a required check that was
    skipped never counts as green: required checks accept only the literal 'success'."""
    return b if state_rank(b) > state_rank(a) else a


def head_states(gh, repo, sha, cfg):
    """Merge check runs and commit statuses on the head SHA into name -> state, keeping the WORSE state when a
    check run and a status share a name, so neither kind can hide the other.

    Contexts named by review_lead / review_principal are read only from statuses created by signer_login (the
    newest one from that account wins); check runs and statuses from anyone else under those names are ignored,
    which makes them 'missing'. Every other name is green only through a check run: the newest status for it can
    make it worse (a failing or pending status still blocks) but never creates or improves it, so a status posted
    by any token with write access cannot stand in for CI. With check_app_ids, a name listed there takes its
    check-run state only from that app and is 'missing' without such a run."""
    signer = (cfg.get("signer_login") or "").strip().lower()
    reviews = {cfg["review_lead"], cfg["review_principal"]}
    app_ids = {k: str(v) for k, v in (cfg.get("check_app_ids") or {}).items()}
    states = {}

    def put(name, state):
        states[name] = worse(states[name], state) if name in states else state

    for r in gh.pages(f"/repos/{repo}/commits/{sha}/check-runs", "check_runs"):
        name = r["name"]
        if name in reviews: continue
        if name in app_ids and str((r.get("app") or {}).get("id")) != app_ids[name]: continue
        put(name, (r.get("conclusion") or "unknown") if r.get("status") == "completed" else "pending")
    for name in app_ids:
        states.setdefault(name, "missing")
    # Every status on the SHA, newest first (the combined-status view keeps only one per context, which would let
    # someone else's later status shadow the signer's).
    statuses = sorted(gh.pages(f"/repos/{repo}/commits/{sha}/statuses"),
                      key=lambda s: (s.get("created_at") or "", s.get("id") or 0), reverse=True)
    seen = set()
    for s in statuses:
        ctx = s["context"]
        if ctx in reviews and not (signer and ((s.get("creator") or {}).get("login") or "").lower() == signer):
            continue
        if ctx in seen: continue
        seen.add(ctx)
        if ctx in reviews or ctx in states or state_rank(s["state"]) > 0:
            put(ctx, s["state"])  # a non-review status never brings a check into being as green
    return states


def signer_reason(cfg):
    """None when signer_login is set and is not an account anything else on the host writes as.
    broker_login must be set too (the broker token's login, or "-" when no broker runs on this host):
    left empty, a signer that shares the broker's account would pass unseen, so every merge is refused."""
    signer = (cfg.get("signer_login") or "").strip().casefold()
    if not signer: return NO_SIGNER
    if not (cfg.get("broker_login") or "").strip(): return NO_BROKER
    others = {(cfg.get(k) or "").strip().casefold() for k in ("broker_login", "_gate_login")} - {"", "-"}
    return SHARED_SIGNER if signer in others else None


# ---------- state ----------
def load_state(path):
    try:
        with open(path) as f: return json.load(f)
    except FileNotFoundError: return {"done": {}, "attempts": {}, "logged": {}}


def save_state(path, st):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f: json.dump(st, f, indent=1, sort_keys=True)
    os.replace(tmp, path)


def load_config(path):
    with open(path) as f: raw = json.load(f)
    cfg = {**DEFAULTS, **raw}
    if not cfg.get("repos"): raise ValueError("config: repos is empty")
    if not cfg["owner_emails"]: raise ValueError("config: owner_emails is empty (fail closed)")
    if not cfg["prefixes"]: raise ValueError("config: prefixes is empty (fail closed)")
    if signer_reason(cfg) == SHARED_SIGNER: raise ValueError("config: " + SHARED_SIGNER)
    pats = cfg["extra_message_patterns"]
    if not isinstance(pats, list) or not all(isinstance(p, str) and p for p in pats):
        raise ValueError("config: extra_message_patterns must be a list of non-empty regex strings")
    for i, p in enumerate(pats):
        try: re.compile(p, re.I | re.M)
        except re.error as e: raise ValueError(f"config: extra_message_patterns[{i}] is not a valid regex: {e}")
    return cfg


# ---------- one pass ----------
def process_pr(gh, cfg, repo, pr, st, dry):
    n, sha = pr["number"], pr["head"]["sha"]
    text_hash = hashlib.sha256(((pr.get("title") or "") + "\0" + (pr.get("body") or "")).encode()).hexdigest()[:10]
    key = f"{repo}#{n}@{sha[:12]}:{text_hash}"
    why = gate_reason(cfg, pr)
    if why is None and key in st["done"]: why = "already " + st["done"][key]
    if why is None and st["attempts"].get(key, 0) >= MAX_ATTEMPTS: why = "merge attempts exhausted"
    if why is None: why = signer_reason(cfg)
    if why is None:
        commits = gh.pages(f"/repos/{repo}/pulls/{n}/commits")
        bad, text_hit = message_policy_problems(cfg, pr, commits)
        if bad or text_hit:
            desc = message_policy_description(bad, text_hit)
            log(f"REFUSE {repo}#{n} @{sha[:8]}: {desc}")
            if not dry:
                gh.post(f"/repos/{repo}/statuses/{sha}", {"state": "failure", "context": CONTEXT, "description": desc})
                st["done"][key] = "refused (commit message policy)"
            return
        files = gh.pages(f"/repos/{repo}/pulls/{n}/files")
        paths = [f["filename"] for f in files] + [f["previous_filename"] for f in files if f.get("previous_filename")]
        lines = sum(f.get("additions", 0) + f.get("deletions", 0) for f in files)
        tier, states = tier_for(cfg, paths), head_states(gh, repo, sha, cfg)
        why = checks_reason(cfg, states) or review_reason(cfg, tier, lines, states)
    if why:
        if st["logged"].get(f"{repo}#{n}@{sha[:12]}") != why:  # log each skip reason once per SHA
            log(f"SKIP {repo}#{n} @{sha[:8]}: {why}")
            if not dry:
                if why in (NO_SIGNER, NO_BROKER, SHARED_SIGNER):
                    gh.post(f"/repos/{repo}/statuses/{sha}", {"state": "failure", "context": CONTEXT, "description": why})
                st["logged"][f"{repo}#{n}@{sha[:12]}"] = why
        return
    log(f"MERGE {repo}#{n} @{sha[:8]} tier={tier} lines={lines} method={cfg['merge_method']}" + (" (dry-run)" if dry else ""))
    if dry: return
    st["attempts"][key] = st["attempts"].get(key, 0) + 1
    code, resp = gh.put(f"/repos/{repo}/pulls/{n}/merge", {
        "sha": sha, "merge_method": cfg["merge_method"], "commit_title": pr["title"], "commit_message": pr.get("body") or ""})
    if code == 200:
        st["done"][key] = "merged"
        log(f"MERGED {repo}#{n} @{sha[:8]}")
    else:
        log(f"FAILED {repo}#{n} @{sha[:8]}: HTTP {code} {(resp or {}).get('message', '')}")


def run_pass(cfg, gh, dry):
    st = load_state(STATE)
    for entry in cfg["repos"]:
        repo = entry if isinstance(entry, str) else entry["repo"]
        try:
            prs = gh.pages(f"/repos/{repo}/pulls?state=open")
        except Exception as e:
            log(f"ERROR {repo}: {e}")
            continue
        for pr in prs:
            try: process_pr(gh, cfg, repo, pr, st, dry)
            except Exception as e: log(f"ERROR {repo}#{pr.get('number')}: {e} (not merged)")
    if not dry: save_state(STATE, st)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Merge gate: merges green, labelled PRs that pass author and commit message checks, on policy.")
    ap.add_argument("--once", action="store_true", help="single pass, then exit (what the timer uses)")
    ap.add_argument("--dry-run", action="store_true", help="print decisions; post and merge nothing, write no state")
    ap.add_argument("--config", default=CONFIG, help="config JSON (env MERGE_GATE_CONFIG)")
    a = ap.parse_args(argv)
    if os.path.exists(KILL):
        log(f"kill switch {KILL} present: no-op")
        return 0
    try: cfg = load_config(a.config)
    except Exception as e:
        log(f"config error: {e}")
        return 2
    try:
        with open(TOKEN_FILE) as f: token = f.read().strip()
    except OSError:
        token = ""
    if not token and not a.dry_run:
        log(f"no token at {TOKEN_FILE}: refusing to run")
        return 2
    lock = None
    if not a.dry_run:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        lock = open(os.path.join(os.path.dirname(STATE), "lock"), "w")
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            log("another pass is running")
            return 0
    gh = Gh(token)
    if token:  # the gate's own account must not be the signer's: its statuses would count as reviews
        try: cfg["_gate_login"] = str((gh.get("/user") or {}).get("login") or "")
        except Exception as e:
            log(f"cannot read the gate token's login ({e}): refusing to run")
            return 2
        if not cfg["_gate_login"]:
            log("the gate token's login is empty: refusing to run")
            return 2
    while True:
        run_pass(cfg, gh, a.dry_run)
        if a.once or a.dry_run: return 0
        time.sleep(cfg["interval"])
        if os.path.exists(KILL): return 0


if __name__ == "__main__":
    sys.exit(main())
