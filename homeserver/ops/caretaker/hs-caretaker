#!/usr/bin/env python3
"""hs-caretaker: a deterministic, no-LLM health loop for a Trinity fleet.

CONCEPT SCRIPT / STARTING POINT. Small on purpose; read it, then adapt it.

Each run (a systemd timer fires it every 5 minutes) it:
  1. lists agents and finds ones that are stopped but should be running,
  2. finds executions stuck in "running" for longer than a threshold,
  3. finds schedules whose latest execution failed,
  4. takes ONE kind of action: start a stopped agent that is on the
     `should_run` list, at most `max_restarts_per_hour` per hour,
  5. records everything else as a finding in a JSON state file and, if
     `notify` is true, raises one Trinity notification per NEW finding.

Dry-run is the default. Nothing is changed on the server until the config
file says "act": true. Missing token, unreachable API or bad config means
the run exits non-zero without acting (fail closed).

Trinity endpoints used (all in src/backend/routers/):
  GET  /api/ops/fleet/status            ops.py:55   agent list + status
  GET  /api/executions                  executions.py:181  running executions
  GET  /api/ops/schedules               ops.py:177  schedules + last execution
  POST /api/agents/{name}/start         agents.py:905  the only action
  POST /api/notifications               notifications.py:73  optional alert
There is no endpoint for an operator to create an operator-queue item (the
queue is raised by an agent as itself: operator_queue.py:663), so findings go
to a notification instead. See README.md.
"""
import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone

NAME = "caretaker"
CONF_DIR = os.environ.get("HS_CARETAKER_DIR", "/etc/homeserver/caretaker")
STATE_DIR = os.environ.get("HS_CARETAKER_STATE_DIR", "/var/lib/homeserver/caretaker")
KILL_SWITCH = os.environ.get("HS_CARETAKER_KILL", "/etc/homeserver/caretaker.disable")
DEFAULTS = {
    "act": False,                 # dry-run unless true
    "should_run": [],             # agent names that must be running
    "ignore": [],                 # agent names never touched or reported
    "max_restarts_per_hour": 3,
    "stuck_minutes": 120,         # a "running" execution older than this is stuck
    "notify": False,              # raise a Trinity notification for new findings
    "notify_priority": "high",
}


def log(msg):
    print(f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} {NAME}: {msg}", flush=True)


class Api:
    """Tiny REST client. Token comes from a file, never from argv or logs."""

    def __init__(self, base, token_file):
        self.base = base.rstrip("/")
        with open(token_file) as fh:
            self.token = fh.read().strip()
        if not self.token:
            raise RuntimeError("token file is empty")

    def call(self, method, path, params=None, body=None):
        url = self.base + path
        if params:
            url += "?" + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(url, data=data, method=method, headers={
            "Authorization": "Bearer " + self.token, "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
        return json.loads(raw) if raw else {}


def parse_ts(value):
    """ISO timestamp -> aware datetime (naive values are taken as UTC)."""
    dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


# ---- pure checks (unit-tested in test_caretaker.py) -------------------------

def find_stopped(agents, should_run, ignore):
    """Agents on the should_run list whose status is not 'running'."""
    return [a["name"] for a in agents
            if a["name"] in should_run and a["name"] not in ignore
            and a.get("status") != "running"]


def find_stuck(executions, now, stuck_minutes, ignore):
    out = []
    for ex in executions:
        if ex.get("agent_name") in ignore or not ex.get("started_at"):
            continue
        age = (now - parse_ts(ex["started_at"])).total_seconds() / 60
        if age > stuck_minutes:
            out.append({"id": ex["id"], "agent": ex["agent_name"], "age_min": int(age)})
    return out


def find_failed_schedules(schedules, ignore):
    out = []
    for s in schedules:
        last = s.get("last_execution") or {}
        if s["enabled"] and s["agent_name"] not in ignore and last.get("status") in ("failed", "error"):
            out.append({"id": s["id"], "agent": s["agent_name"], "name": s["name"]})
    return out


def restart_budget(restart_times, now_ts, per_hour):
    """How many restarts are still allowed in the rolling hour."""
    recent = [t for t in restart_times if now_ts - t < 3600]
    return max(0, per_hour - len(recent)), recent


# ---- state -------------------------------------------------------------------

def load_state(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except FileNotFoundError:
        return {"findings": {}, "restarts": []}


def save_state(path, state):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, indent=2, sort_keys=True)
    os.replace(tmp, path)


def merge_findings(old, current, now_iso):
    """Keep first_seen for ongoing findings, drop resolved ones.
    Returns (merged, new_keys)."""
    merged, new = {}, []
    for key, detail in current.items():
        prev = old.get(key)
        if prev:
            merged[key] = {**prev, "last_seen": now_iso, "detail": detail}
        else:
            merged[key] = {"first_seen": now_iso, "last_seen": now_iso, "detail": detail}
            new.append(key)
    return merged, new


# ---- the run -----------------------------------------------------------------

def run(cfg, api, state_path, now=None):
    now = now or datetime.now(timezone.utc)
    act = bool(cfg["act"])
    ignore, state = set(cfg["ignore"]), load_state(state_path)
    findings = {}

    fleet = api.call("GET", "/api/ops/fleet/status")
    agents = fleet.get("agents", [])
    # Executions: the API only accepts hours in {1,6,24,168,720,0}; 168 covers
    # anything stuck for days, the age filter does the rest.
    running = api.call("GET", "/api/executions",
                       {"status": "running", "hours": 168, "limit": 200})
    sched = api.call("GET", "/api/ops/schedules").get("schedules", [])

    for ex in find_stuck(running, now, cfg["stuck_minutes"], ignore):
        findings[f"stuck:{ex['id']}"] = f"execution {ex['id']} of {ex['agent']} running {ex['age_min']} min"
    for s in find_failed_schedules(sched, ignore):
        findings[f"schedule:{s['id']}"] = f"schedule '{s['name']}' of {s['agent']}: last run failed"

    # The one action: start stopped agents, under an hourly cap.
    allowed, recent = restart_budget(state.get("restarts", []), now.timestamp(),
                                     cfg["max_restarts_per_hour"])
    for name in find_stopped(agents, set(cfg["should_run"]), ignore):
        if allowed <= 0:
            findings[f"stopped:{name}"] = f"{name} is stopped; restart cap reached, needs a human"
            continue
        if not act:
            log(f"DRY-RUN would start {name}")
            findings[f"stopped:{name}"] = f"{name} is stopped (dry-run, not restarted)"
            continue
        try:
            api.call("POST", f"/api/agents/{urllib.parse.quote(name)}/start")
            recent.append(now.timestamp())
            allowed -= 1
            log(f"started {name}")
        except urllib.error.HTTPError as exc:
            findings[f"stopped:{name}"] = f"{name} is stopped; start failed HTTP {exc.code}"

    state["restarts"] = recent
    state["findings"], new_keys = merge_findings(
        state.get("findings", {}), findings, now.isoformat(timespec="seconds"))
    state["last_run"] = now.isoformat(timespec="seconds")
    state["dry_run"] = not act
    save_state(state_path, state)

    for key in new_keys:
        log(f"finding {key}: {findings[key]}")
        if cfg["notify"] and act:
            api.call("POST", "/api/notifications", body={
                "notification_type": "alert", "priority": cfg["notify_priority"],
                "category": "health", "title": f"caretaker: {key}"[:200],
                "message": findings[key]})
    log(f"done: {len(findings)} open findings, {len(new_keys)} new, dry_run={not act}")
    return findings


def load_config(path):
    cfg = dict(DEFAULTS)
    with open(path) as fh:
        user = json.load(fh)
    unknown = set(user) - set(DEFAULTS)
    if unknown:
        raise ValueError(f"unknown config keys: {sorted(unknown)}")
    cfg.update(user)
    return cfg


def main(argv=None):
    ap = argparse.ArgumentParser(description="No-LLM health loop for a Trinity fleet. "
                                 "Dry-run unless the config sets \"act\": true.")
    ap.add_argument("--config", default=os.path.join(CONF_DIR, "config.json"))
    ap.add_argument("--state", default=os.path.join(STATE_DIR, "state.json"))
    ap.add_argument("--dry-run", action="store_true", help="force dry-run even if config says act")
    args = ap.parse_args(argv)

    if os.path.exists(KILL_SWITCH):
        log(f"kill switch {KILL_SWITCH} present, doing nothing")
        return 0
    try:
        cfg = load_config(args.config)
        if args.dry_run:
            cfg["act"] = False
        creds = os.environ.get("CREDENTIALS_DIRECTORY")  # set by systemd LoadCredential=
        token_file = os.environ.get("TRINITY_TOKEN_FILE") or (
            os.path.join(creds, "trinity-token") if creds else os.path.join(CONF_DIR, "token"))
        api = Api(os.environ.get("TRINITY_URL", "http://127.0.0.1:8000"), token_file)
        run(cfg, api, args.state)
        return 0
    except (OSError, ValueError, RuntimeError, urllib.error.URLError) as exc:
        log(f"FAILED CLOSED: {type(exc).__name__}: {exc}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
