[Unit]
Description=Ops desk: rule-based operator-queue triage for Trinity
After=network-online.target
Wants=network-online.target
# Kill switch: touch /etc/homeserver/ops-desk.disable to make this a no-op.
ConditionPathExists=!/etc/homeserver/ops-desk.disable

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hs-ops-desk
Environment=TRINITY_URL=http://127.0.0.1:8000
# The token stays root-only (0600) and is handed to the service as a credential;
# the script reads $CREDENTIALS_DIRECTORY/trinity-token.
LoadCredential=trinity-token:/etc/homeserver/ops-desk/token
DynamicUser=yes
StateDirectory=homeserver/ops-desk
ConfigurationDirectory=homeserver/ops-desk
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
TimeoutStartSec=120
