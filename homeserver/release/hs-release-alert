#!/usr/bin/env bash
# Runs when hs-release.service fails (OnFailure=): exit 1 = error before any
# switch, 2 = a release failed the health gate and was rolled back, 3 = the
# schema moved and a person must restore, 4 = broken (the state is unknown; every
# later run fails the same way until `hs-release clear-broken`). Tells a person;
# changes nothing.
#
# HS_RELEASE_ALERT_URL (in /etc/default/hs-release): the message is POSTed to it
# as text/plain, which ntfy and most webhook receivers accept (Title header set).
# Unset, invalid, or if the POST fails: the message goes to the journal at priority err.
# Valid = starts with http:// or https://, no whitespace, no #. (systemd's
# EnvironmentFile only treats a line that STARTS with # as a comment, so a trailing
# comment on the value ends up inside the URL.)
#
#   hs-release-alert --test   send a test message to the alert URL; exits non-zero
#                             when HS_RELEASE_ALERT_URL is unset or invalid or the POST fails.
#                             A required install step (RELEASES.md, "Install").
set -euo pipefail

# The defaults file, read the way systemd's EnvironmentFile reads it, so a run by
# hand sees the same settings as the units (the same code is in hs-release).
# KEY=VALUE lines; blank lines and lines starting with # or ; are skipped;
# surrounding quotes are stripped. The file is data: it is never sourced or
# evaluated, a `$(...)` in it is just text. A variable already set in the
# environment wins. HS_RELEASE_DEFAULTS moves the path (tests).
load_defaults() {
  local f=${HS_RELEASE_DEFAULTS:-/etc/default/hs-release} line k v
  [ -f "$f" ] && [ -r "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    case $line in ''|'#'*|';'*) continue ;; esac
    [[ $line == *=* ]] || continue
    k=${line%%=*}; v=${line#*=}
    [[ $k =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    case $k in IFS|PS4|ENV|BASH*|SHELL*|LD_*) continue ;; esac   # nothing that changes how this shell runs
    [ -z "${!k+x}" ] || continue
    if [ "${#v}" -ge 2 ]; then
      case $v in
        \"*\") v=${v:1:${#v}-2} ;;
        \'*\') v=${v:1:${#v}-2} ;;
      esac
    fi
    export "$k=$v"
  done < "$f"
}
load_defaults

STATE=${HS_RELEASE_STATE:-/var/lib/hs-release}
host=$(hostname)
# What the BLOCKED line says depends on what the blocked file records in
# services_stopped=: only `backend scheduler` means the app was stopped on purpose.
blocked_line() {
  [ -f "$STATE/blocked" ] || return 0
  local tag stopped
  tag=$(sed -n 's/^tag=//p' "$STATE/blocked"); stopped=$(sed -n 's/^services_stopped=//p' "$STATE/blocked")
  case $stopped in
    "backend scheduler")
      echo "BLOCKED: the failed release $tag is pinned and its backend and scheduler are stopped on purpose (services_stopped=$stopped): the app is down until a person acts." ;;
    none)
      echo "BLOCKED: the failed release $tag is pinned and nothing was stopped (services_stopped=none, an external database): the failed release is running and has NOT been verified healthy. A person has to act." ;;
    *)
      echo "BLOCKED: the failed release $tag is pinned and the stop of its backend and scheduler did not finish or failed (services_stopped=$stopped): the failed release may be serving on a moved schema. Check docker ps, then a person has to act." ;;
  esac
}

msg="hs-release on $host did not finish cleanly (rolled back, schema moved, broken, or an error). Last log lines:
$(tail -n 8 "$STATE/log" 2>/dev/null || echo '(no log)')
$(blocked_line)
Next steps: hs-release status; see RELEASES.md, \"Rolling back\"."

url_problem() {  # why the URL is unusable; nothing when unset or fine
  local u=${HS_RELEASE_ALERT_URL:-}
  [ -n "$u" ] || return 0
  case $u in
    *[[:space:]]*) echo "it contains whitespace (a comment after the value? systemd does not strip it)" ;;
    *'#'*) echo "it contains # (a comment after the value? systemd does not strip it)" ;;
    http://?*|https://?*) ;;
    *) echo "it does not start with http:// or https://" ;;
  esac
}
bad_url=$(url_problem)

if [ "${1:-}" = --test ]; then
  if [ -n "$bad_url" ]; then
    echo "hs-release-alert: HS_RELEASE_ALERT_URL is invalid: $bad_url. Put the value alone on its line in /etc/default/hs-release (a comment goes on its own line), then run --test again" >&2
    exit 1
  fi
  if [ -z "${HS_RELEASE_ALERT_URL:-}" ]; then
    echo "hs-release-alert: HS_RELEASE_ALERT_URL is not set (/etc/default/hs-release); a failed hs-release run would only reach the journal" >&2
    exit 1
  fi
  if ! curl -fsS -m 20 -H "Title: hs-release on $host (test)" -H 'Priority: default' \
       -H 'Content-Type: text/plain' --data-binary "hs-release alert test from $host: if you can read this, failed runs will reach you." "$HS_RELEASE_ALERT_URL" >/dev/null; then
    echo "hs-release-alert: the test message could not be posted to the alert URL" >&2
    exit 1
  fi
  echo "hs-release-alert: test message sent"
  exit 0
fi

to_journal() { printf '%s\n' "$msg" | logger -p daemon.err -t hs-release-alert; }

if [ -z "${HS_RELEASE_ALERT_URL:-}" ]; then to_journal; exit 0; fi
if [ -n "$bad_url" ]; then
  to_journal
  echo "HS_RELEASE_ALERT_URL is invalid ($bad_url); this alert was not posted and is only in the journal. Fix /etc/default/hs-release and run: hs-release-alert --test" | logger -p daemon.err -t hs-release-alert
  echo "hs-release-alert: HS_RELEASE_ALERT_URL is invalid ($bad_url); wrote to the journal" >&2
  exit 1
fi
if ! curl -fsS -m 20 -H "Title: hs-release on $host" -H 'Priority: high' \
     -H 'Content-Type: text/plain' --data-binary "$msg" "$HS_RELEASE_ALERT_URL" >/dev/null; then
  to_journal
  echo "hs-release-alert: could not post to the alert URL; wrote to the journal" >&2
  exit 1
fi
